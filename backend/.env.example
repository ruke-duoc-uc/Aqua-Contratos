# Puerto de ejecución del servidor Express
PORT=4000

# Origen permitido para CORS (Frontend Vite)
FRONTEND_URL=http://localhost:5173

# --- Notificaciones por correo (Resend) ---
# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente verificado en Resend.
# "onboarding@resend.dev" solo permite enviar al correo dueño de la cuenta.
RESEND_FROM=onboarding@resend.dev

# Correo del analista que recibe el aviso de nuevas postulaciones
CORREO_INFORME=
