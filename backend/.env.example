# Puerto de ejecución del servidor Express
PORT=4000

# Origen permitido para CORS (Frontend Vite)
FRONTEND_URL=http://localhost:5173

# Cadena de conexión a MongoDB (Local o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/aqua_contratos

# Clave secreta y tiempo de expiración para firma de Tokens JWT
JWT_SECRET=aqua_contratos_secret_key_jwt_2026_super_seguro
JWT_EXPIRATION=24h

# Notificaciones por Correo Electrónico (Resend)
RESEND_API_KEY=
RESEND_FROM=AquaChile Reclutamiento <onboarding@resend.dev>
CORREO_INFORME=analista@aquachile.cl

# Integración Oficial Google Calendar API y Google Meet (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth2callback
GOOGLE_REFRESH_TOKEN=
